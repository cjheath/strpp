// Spanish wordings of strpp.mcs's messages.

esText: Set.Message.Text { Language = Languages.es; }

StrVal {
	ASSERT { : esText ~= 'En {1}:{2}, falló la aserción: `{3}`'; }
	TRAIL_TEXT { : esText ~= 'El número `{1}` en base {2} terminó en el carácter {3}, dejando `{4}` sin leer'; }
	NO_DIGITS { : esText ~= 'No se pudo leer un número de `{1}` en base {2}'; }
	NUMBER_OVERFLOW { : esText ~= 'El número `{1}` en base {2} no cabe en `{4}`, desbordando en el carácter {3}; el valor devuelto está incompleto'; }
	NOT_NUMBER { : esText ~= 'No se puede leer `{1}` como número en base {2}: el carácter `{3}` en la posición {4} no es un dígito'; }
	NEGATIVE_UNSIGNED { : esText ~= 'Se esperaba que `{1}` fuese sin signo en base {2}, pero es negativo'; }
	ILLEGAL_RADIX { : esText ~= 'Se rechazó el intento de leer `{2}` en la base ilegal {1}'; }
	INDEX_OUT_OF_RANGE { : esText ~= 'No es posible {3} el elemento {1} de un arreglo de {2} elementos'; }
}

Variants {
	WRONG_TYPE { : esText ~= 'Se esperaba `{1}`, no `{2}`'; }
	DOES_NOT_FIT { : esText ~= 'El valor {2} desbordaría un `{1}`'; }
	NO_COERCION { : esText ~= 'La conversión de `{1}` a `{2}` no está implementada; se deja como está'; }
}

DateTime {
	INVALID_YMDHMS { : esText ~= 'La fecha y hora {1}-{2}-{3} {4}:{5}:{6} no existe'; }
	INVALID_TEXT { : esText ~= '`{1}` no es una hora, una fecha ni un intervalo válidos'; }
	OUT_OF_RANGE { : esText ~= 'La fecha {1} está fuera del rango que podemos contener (de {2} a {3})'; }
	NO_DATE { : esText ~= 'Se quería una fecha, pero solo se recibió una hora del día'; }
	NO_CLOCK { : esText ~= 'No hay reloj disponible para dar la hora actual'; }
	NULL_VALUE { : esText ~= 'Valor nulo `{1}` recibido para {2}'; }
	RESULT_OVERFLOW { : esText ~= 'El resultado de {2} desbordaría un `{1}`'; }
	NO_ZONE { : esText ~= 'Se pidió la hora local, pero no conocemos la zona horaria. Se usa UTC'; }
}

Threads {
	CREATE_FAILED { : esText ~= '`{1}` devolvió {2}, diciendo que falló al crear un hilo'; }
	STACK_REFUSED { : esText ~= '`{2}` rechazó un tamaño de pila de {1} bytes (código de error {3}). Se usa el tamaño predeterminado'; }
	JOIN_FAILED { : esText ~= 'No se pudo {1} al hilo (código de error {2}); su código de salida es desconocido'; }
	NO_CONDITION { : esText ~= 'No se puede {1} la variable de condición porque no se creó correctamente'; }
	WAIT_FAILED { : esText ~= 'El hilo {1} falló (código de error {2})'; }
	DELAY_FAILED { : esText ~= 'El hilo {1} falló (código de error {2})'; }
}

Strpp;
