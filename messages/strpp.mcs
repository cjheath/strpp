// strpp's Error messages

// tools/msggen regenerates strpp_err.h and strpp_msg.h from this file.
// Test it with:
//	cd adl/cpp && ./adlmem -a adl.adl -a ietf_languages.adl \
//		-a ../../strpp/tools/mcs.adl -a ../../strpp/messages/strpp.mcs

// Message default text is directly assigned using String's Syntax.
// Other languages create additional Text objects under each Message.

// Message numbers use final assignment, so those cannot be over-ridden.
// The Sets are marked `Is Complete`, so new messages may not be added
// by any extension or refinement.

// Parameter types are not yet declared here.

Strpp: Message Catalog Source {

	// Set 1: STR - the StrVal messages, including reading numbers
	StrVal: Set {
		Prefix ~= 'STR';
		Number ~= 1;
		Language ~= Languages.en;

		Assert: Message { Number = 1; } ~= 'At {1}:{2}, assertion failed: `{3}`';

		Trailing text: Message { Number = 2; } ~= 'The number `{1}` in radix {2} ended at character {3}, leaving `{4}` unread';
		No digits: Message { Number = 3; } ~= 'Failed to read a number from `{1}` in radix {2}';
		Number overflow: Message { Number = 4; } ~= 'The number `{1}` in radix {2} does not fit in `{3}`, overflowing at character {4}; the value returned is incomplete';
		Not number: Message { Number = 5; } ~= 'Cannot read `{1}` as a number in radix {2}: the character `{3}` at position {4} is not a digit';
		Negative unsigned: Message { Number = 7; } ~= 'Expected `{1}` to be unsigned in radix {2} but it is negative';
		Illegal radix: Message { Number = 6; } ~= 'Attempt to read `{1}` in illegal radix {2} was rejected';

		// Parameter 3 is the operation: "remove", "drop", "take", "slice"
		Index out of range: Message { Number = 8; } ~= 'Indexing to {1} element {2} in array of {3} elements is not possible';

		Is Complete = True;
	}

	// Set 2: VAR - a Variant's type, and a conversion that would lose the value.
	Variants: Set {
		Prefix ~= 'VAR';
		Number ~= 2;
		Language ~= Languages.en;

		Wrong type: Message { Number = 1; } ~= 'Expected `{1}`, not `{2}`';
		Does not fit: Message { Number = 2; } ~= 'Value {1} would overflow a `{2}`';
		No coercion: Message { Number = 3; } ~= 'Conversion from `{1}` to `{2}` is not implemented, leaving it alone';

		Is Complete = True;
	}

	// Set 3: TIM - the times and dates.
	DateTime: Set {
		Prefix ~= 'TIM';
		Number ~= 3;
		Language ~= Languages.en;

		Invalid YMDHMS: Message { Number = 1; } ~= 'Date/Time {1}-{2}-{3} {4}:{5}:{6} does not exist';
		Invalid text: Message { Number = 2; } ~= '`{1}` is not a valid time, a date or interval';
		Out of range: Message { Number = 3; } ~= 'Date {1} falls outside the range we can hold (from {2} to {3})';
		No date: Message { Number = 4; } ~= 'Wanted a Date but only received a time of day';
		No clock: Message { Number = 5; } ~= 'No clock is available to provide the current time';
		Null value: Message { Number = 6; } ~= 'Null value `{1}` received for a {2}';
		Result overflow: Message { Number = 7; } ~= 'Result of {1} would overflow a `{2}`';
		No zone: Message { Number = 8; } ~= 'You asked for localtime but we don\'t know the timezone. Using UTC';

		Is Complete = True;
	}

	// Set 4: THR - the threads, the locks and the waits.
	// The second/third parameter of each is the host's error code
	Threads: Set {
		Prefix ~= 'THR';
		Number ~= 4;
		Language ~= Languages.en;

		Create failed: Message { Number = 1; } ~= '`{1}` returned {2} saying it failed to create a thread';
		Stack refused: Message { Number = 2; } ~= '`{1}` refused a stack size of {2} bytes (error code {3}). Using the default size';
		Join failed: Message { Number = 3; } ~= 'Failed to {1} for thread (error code {2}); its exit code is unknown';
		No condition: Message { Number = 4; } ~= 'Cannot {1} condition variable because it was not successfully created';
		Wait failed: Message { Number = 5; } ~= 'Thread {1} failed (error code {2})';
		Delay failed: Message { Number = 6; } ~= 'Thread {1} failed (error code {2})';

		Is Complete = True;
	}
}
